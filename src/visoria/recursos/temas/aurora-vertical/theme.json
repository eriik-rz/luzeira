{
  "format": "visoria-theme/1",
  "name": "Aurora Vertical",
  "author": "Visoria",
  "orientation": "portrait",
  "background": {"color": "#060c22", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 10, "y": 30, "width": 300, "height": 88}, "style": {"size": 80, "color": "#ffffff", "align": "center", "bold": true}},
    {"type": "clock", "format": "date-long", "box": {"x": 10, "y": 120, "width": 300, "height": 26}, "style": {"size": 17, "color": "#eafff7", "align": "center"}},
    {"type": "text", "text": "CPU", "box": {"x": 32, "y": 180, "width": 100, "height": 22}, "style": {"size": 15, "color": "#6dffb4", "align": "left", "bold": true}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 32, "y": 200, "width": 140, "height": 42}, "style": {"size": 34, "color": "#ffffff", "align": "left", "bold": true}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#6dffb4", "track": "#1a2c48", "box": {"x": 176, "y": 218, "width": 112, "height": 8}},
    {"type": "text", "text": "GPU", "box": {"x": 32, "y": 258, "width": 100, "height": 22}, "style": {"size": 15, "color": "#5ee0f0", "align": "left", "bold": true}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 176, "y": 258, "width": 112, "height": 22}, "style": {"size": 15, "color": "#c8d8f0", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 32, "y": 278, "width": 140, "height": 42}, "style": {"size": 34, "color": "#ffffff", "align": "left", "bold": true}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#5ee0f0", "track": "#1a2c48", "box": {"x": 176, "y": 296, "width": 112, "height": 8}},
    {"type": "text", "text": "RAM", "box": {"x": 32, "y": 336, "width": 100, "height": 22}, "style": {"size": 15, "color": "#b9a0ff", "align": "left", "bold": true}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 176, "y": 336, "width": 112, "height": 22}, "style": {"size": 15, "color": "#c8d8f0", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 32, "y": 356, "width": 140, "height": 42}, "style": {"size": 34, "color": "#ffffff", "align": "left", "bold": true}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#b9a0ff", "track": "#1a2c48", "box": {"x": 176, "y": 374, "width": 112, "height": 8}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 30, "y": 426, "width": 130, "height": 28}, "style": {"size": 17, "color": "#ffffff", "align": "left", "bold": true}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 160, "y": 426, "width": 130, "height": 28}, "style": {"size": 17, "color": "#c9b8ff", "align": "right"}}
  ]
}
