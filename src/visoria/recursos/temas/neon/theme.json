{
  "format": "visoria-theme/1",
  "name": "Neón",
  "author": "Visoria",
  "orientation": "landscape",
  "background": { "color": "#0a0618", "image": "fondo.png" },
  "widgets": [
    { "type": "clock", "format": "HH:MM", "box": { "x": 16, "y": 10, "width": 180, "height": 56 },
      "style": { "size": 46, "bold": true, "color": "#00e6ff", "align": "left" } },
    { "type": "clock", "format": "date-long", "box": { "x": 196, "y": 14, "width": 268, "height": 26 },
      "style": { "size": 16, "color": "#d9ccff", "align": "right" } },
    { "type": "sensor", "sensor": "gpu.name", "max_chars": 30, "box": { "x": 196, "y": 42, "width": 268, "height": 22 },
      "style": { "size": 13, "color": "#8f7bd6", "align": "right" } },

    { "type": "text", "text": "CPU", "box": { "x": 24, "y": 84, "width": 100, "height": 22 },
      "style": { "size": 15, "bold": true, "color": "#00e6ff", "align": "left" } },
    { "type": "sensor", "sensor": "cpu.usage", "box": { "x": 24, "y": 108, "width": 200, "height": 62 },
      "style": { "size": 52, "bold": true, "align": "left" } },
    { "type": "bar", "sensor": "cpu.usage", "fill": "#00e6ff", "track": "#1d1236",
      "box": { "x": 24, "y": 178, "width": 198, "height": 12 } },
    { "type": "sensor", "sensor": "cpu.name", "max_chars": 28, "box": { "x": 24, "y": 198, "width": 200, "height": 20 },
      "style": { "size": 12, "color": "#8f7bd6", "align": "left" } },

    { "type": "text", "text": "GPU", "box": { "x": 258, "y": 84, "width": 100, "height": 22 },
      "style": { "size": 15, "bold": true, "color": "#ff40c8", "align": "left" } },
    { "type": "sensor", "sensor": "gpu.temperature", "box": { "x": 358, "y": 84, "width": 98, "height": 22 },
      "style": { "size": 15, "color": "#ff9be4", "align": "right" } },
    { "type": "sensor", "sensor": "gpu.usage", "box": { "x": 258, "y": 108, "width": 200, "height": 62 },
      "style": { "size": 52, "bold": true, "align": "left" } },
    { "type": "bar", "sensor": "gpu.usage", "fill": "#ff40c8", "track": "#2a1030",
      "box": { "x": 258, "y": 178, "width": 198, "height": 12 } },
    { "type": "sensor", "sensor": "gpu.power", "box": { "x": 258, "y": 198, "width": 100, "height": 20 },
      "style": { "size": 13, "color": "#d9ccff", "align": "left" } },
    { "type": "sensor", "sensor": "gpu.memory_used", "decimals": 1, "suffix": " VRAM",
      "box": { "x": 330, "y": 198, "width": 126, "height": 20 },
      "style": { "size": 13, "color": "#d9ccff", "align": "right" } },

    { "type": "text", "text": "RAM", "box": { "x": 24, "y": 246, "width": 80, "height": 20 },
      "style": { "size": 13, "bold": true, "color": "#ff40c8", "align": "left" } },
    { "type": "sensor", "sensor": "memory.usage", "box": { "x": 24, "y": 266, "width": 100, "height": 36 },
      "style": { "size": 28, "bold": true, "align": "left" } },
    { "type": "bar", "sensor": "memory.usage", "fill": "#ff40c8", "track": "#2a1030",
      "box": { "x": 128, "y": 280, "width": 112, "height": 10 } },
    { "type": "text", "text": "RED", "box": { "x": 262, "y": 246, "width": 60, "height": 20 },
      "style": { "size": 13, "bold": true, "color": "#00e6ff", "align": "left" } },
    { "type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ",
      "box": { "x": 316, "y": 244, "width": 140, "height": 26 },
      "style": { "size": 17, "bold": true, "align": "right" } },
    { "type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ",
      "box": { "x": 316, "y": 274, "width": 140, "height": 26 },
      "style": { "size": 17, "color": "#c8ccd6", "align": "right" } }
  ]
}
