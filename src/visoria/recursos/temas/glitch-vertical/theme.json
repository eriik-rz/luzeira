{
  "format": "visoria-theme/1",
  "name": "Glitch Vertical",
  "author": "Visoria",
  "orientation": "portrait",
  "background": {"color": "#08080e", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 10, "y": 14, "width": 300, "height": 76}, "style": {"size": 70, "bold": true, "color": "#c6ff00", "align": "center"}},
    {"type": "clock", "format": "date-long", "box": {"x": 24, "y": 94, "width": 272, "height": 24}, "style": {"size": 16, "bold": true, "color": "#00e1f0", "align": "center"}},

    {"type": "text", "text": "CPU", "box": {"x": 22, "y": 132, "width": 52, "height": 22}, "style": {"size": 15, "bold": true, "color": "#0b0b10", "align": "center"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 24, "y": 158, "width": 140, "height": 56}, "style": {"size": 44, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#c6ff00", "track": "#2c3a06", "box": {"x": 166, "y": 182, "width": 130, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 166, "y": 182, "width": 130, "height": 12}},

    {"type": "text", "text": "GPU", "box": {"x": 22, "y": 232, "width": 52, "height": 22}, "style": {"size": 15, "bold": true, "color": "#0b0b10", "align": "center"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 180, "y": 234, "width": 112, "height": 20}, "style": {"size": 16, "bold": true, "color": "#ff9cc0", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 24, "y": 258, "width": 140, "height": 56}, "style": {"size": 44, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#ff2d78", "track": "#40122a", "box": {"x": 166, "y": 282, "width": 130, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 166, "y": 282, "width": 130, "height": 12}},

    {"type": "text", "text": "RAM", "box": {"x": 22, "y": 332, "width": 52, "height": 22}, "style": {"size": 15, "bold": true, "color": "#0b0b10", "align": "center"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 180, "y": 334, "width": 112, "height": 20}, "style": {"size": 16, "bold": true, "color": "#9ff6ff", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 24, "y": 356, "width": 140, "height": 46}, "style": {"size": 36, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#00e1f0", "track": "#0c3438", "box": {"x": 166, "y": 376, "width": 130, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 166, "y": 376, "width": 130, "height": 12}},

    {"type": "text", "text": "RED", "box": {"x": 22, "y": 434, "width": 44, "height": 24}, "style": {"size": 15, "bold": true, "color": "#c6ff00", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 68, "y": 434, "width": 116, "height": 24}, "style": {"size": 16, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 186, "y": 434, "width": 112, "height": 24}, "style": {"size": 16, "color": "#00e1f0", "align": "right"}}
  ]
}
