{
  "format": "visoria-theme/1",
  "name": "Synthwave",
  "author": "Visoria",
  "orientation": "landscape",
  "background": {"color": "#140328", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 16, "y": 10, "width": 260, "height": 72}, "style": {"size": 64, "bold": true, "color": "#ffe08a", "align": "left"}},
    {"type": "clock", "format": "date-long", "box": {"x": 18, "y": 84, "width": 262, "height": 24}, "style": {"size": 17, "color": "#ffb3e6", "align": "left"}},

    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 18, "y": 124, "width": 200, "height": 22}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 18, "y": 148, "width": 200, "height": 22}, "style": {"size": 15, "color": "#e0b8ff", "align": "left"}},

    {"type": "text", "text": "CPU", "box": {"x": 28, "y": 220, "width": 60, "height": 18}, "style": {"size": 13, "bold": true, "color": "#ff9646", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 28, "y": 240, "width": 120, "height": 40}, "style": {"size": 32, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#ff9646", "track": "#3a1a2a", "box": {"x": 28, "y": 286, "width": 120, "height": 8}},

    {"type": "text", "text": "GPU", "box": {"x": 180, "y": 220, "width": 60, "height": 18}, "style": {"size": 13, "bold": true, "color": "#ff3cc8", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 232, "y": 220, "width": 68, "height": 18}, "style": {"size": 13, "color": "#e8d6ff", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 180, "y": 240, "width": 120, "height": 40}, "style": {"size": 32, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#ff3cc8", "track": "#3a0f3c", "box": {"x": 180, "y": 286, "width": 120, "height": 8}},

    {"type": "text", "text": "RAM", "box": {"x": 332, "y": 220, "width": 60, "height": 18}, "style": {"size": 13, "bold": true, "color": "#00dcff", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 384, "y": 220, "width": 68, "height": 18}, "style": {"size": 13, "color": "#e8d6ff", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 332, "y": 240, "width": 120, "height": 40}, "style": {"size": 32, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#00dcff", "track": "#0d2a44", "box": {"x": 332, "y": 286, "width": 120, "height": 8}}

  ]
}
