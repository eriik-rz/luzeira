{
  "format": "visoria-theme/1",
  "name": "Reloj Vertical",
  "author": "Visoria",
  "orientation": "portrait",
  "background": {"color": "#0b1020", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "weekday", "box": {"x": 0, "y": 82, "width": 320, "height": 32}, "style": {"size": 24, "color": "#ffc98a", "align": "center"}},
    {"type": "clock", "format": "HH:MM", "box": {"x": 0, "y": 112, "width": 320, "height": 112}, "style": {"size": 96, "bold": true, "color": "#ffffff", "align": "center"}},
    {"type": "clock", "format": "date-short", "box": {"x": 0, "y": 226, "width": 320, "height": 30}, "style": {"size": 20, "color": "#c8ccd6", "align": "center"}},

    {"type": "text", "text": "CPU", "box": {"x": 32, "y": 318, "width": 80, "height": 24}, "style": {"size": 15, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 160, "y": 318, "width": 128, "height": 24}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#ffb347", "track": "#252b3d", "box": {"x": 32, "y": 350, "width": 256, "height": 4}},

    {"type": "text", "text": "GPU", "box": {"x": 32, "y": 370, "width": 80, "height": 24}, "style": {"size": 15, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 160, "y": 370, "width": 128, "height": 24}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#ffb347", "track": "#252b3d", "box": {"x": 32, "y": 402, "width": 256, "height": 4}},

    {"type": "text", "text": "RAM", "box": {"x": 32, "y": 422, "width": 80, "height": 24}, "style": {"size": 15, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 160, "y": 422, "width": 128, "height": 24}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#ffb347", "track": "#252b3d", "box": {"x": 32, "y": 454, "width": 256, "height": 4}}

  ]
}
