    {"type": "bar", "sensor": "cpu.usage", "min": 80, "max": 100, "fill": "#e10600", "track": "#3a1210", "box": {"x": 410, "y": 82, "width": 46, "height": 22}},
    {"type": "text", "text": "GPU", "box": {"x": 26, "y": 136, "width": 60, "height": 22}, "style": {"size": 16, "bold": true, "color": "#ff3b30", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.clock", "box": {"x": 26, "y": 160, "width": 100, "height": 20}, "style": {"size": 14, "color": "#a8a8b0", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.usage", "show_unit": false, "suffix": "%", "box": {"x": 92, "y": 134, "width": 112, "height": 50}, "style": {"size": 36, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "gpu.usage", "min": 0, "max": 80, "fill": "#ececec", "track": "#202024", "box": {"x": 216, "y": 144, "width": 190, "height": 22}},
    {"type": "bar", "sensor": "gpu.usage", "min": 80, "max": 100, "fill": "#e10600", "track": "#3a1210", "box": {"x": 410, "y": 144, "width": 46, "height": 22}},
    {"type": "text", "text": "RAM", "box": {"x": 26, "y": 198, "width": 60, "height": 22}, "style": {"size": 16, "bold": true, "color": "#ff3b30", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 26, "y": 222, "width": 100, "height": 20}, "style": {"size": 14, "color": "#a8a8b0", "align": "left"}},
    {"type": "sensor", "sensor": "memory.usage", "show_unit": false, "suffix": "%", "box": {"x": 92, "y": 196, "width": 112, "height": 50}, "style": {"size": 36, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "memory.usage", "min": 0, "max": 80, "fill": "#ececec", "track": "#202024", "box": {"x": 216, "y": 206, "width": 190, "height": 22}},
    {"type": "bar", "sensor": "memory.usage", "min": 80, "max": 100, "fill": "#e10600", "track": "#3a1210", "box": {"x": 410, "y": 206, "width": 46, "height": 22}},
    {"type": "text", "text": "TEMP GPU", "box": {"x": 22, "y": 263, "width": 123, "height": 18}, "style": {"size": 14, "bold": true, "color": "#a8a8b0", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 22, "y": 280, "width": 129, "height": 24}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "text", "text": "POTENCIA GPU", "box": {"x": 178, "y": 263, "width": 123, "height": 18}, "style": {"size": 14, "bold": true, "color": "#a8a8b0", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.power", "box": {"x": 178, "y": 280, "width": 129, "height": 24}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "text", "text": "BAJADA", "box": {"x": 334, "y": 263, "width": 123, "height": 18}, "style": {"size": 14, "bold": true, "color": "#a8a8b0", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 334, "y": 280, "width": 129, "height": 24}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "left"}}
  ]
}
