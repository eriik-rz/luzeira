    {"type": "clock", "format": "HH:MM", "box": {"x": 20, "y": 4, "width": 140, "height": 50}, "style": {"size": 40, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "clock", "format": "date-long", "box": {"x": 220, "y": 8, "width": 240, "height": 22}, "style": {"size": 15, "color": "#d0d0d6", "align": "right"}},
    {"type": "sensor", "sensor": "system.uptime", "decimals": 1, "prefix": "ENCENDIDO ", "box": {"x": 220, "y": 30, "width": 240, "height": 20}, "style": {"size": 14, "color": "#a8a8b0", "align": "right"}},
    {"type": "text", "text": "CPU", "box": {"x": 26, "y": 74, "width": 60, "height": 22}, "style": {"size": 16, "bold": true, "color": "#ff3b30", "align": "left"}},
    {"type": "sensor", "sensor": "disk.usage.c", "prefix": "C: ", "box": {"x": 26, "y": 98, "width": 64, "height": 20}, "style": {"size": 14, "color": "#a8a8b0", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "show_unit": false, "suffix": "%", "box": {"x": 92, "y": 72, "width": 112, "height": 50}, "style": {"size": 36, "bold": true, "color": "#ffffff", "align": "right"}},
