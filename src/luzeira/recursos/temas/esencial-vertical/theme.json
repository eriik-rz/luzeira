{
  "format": "luzeira-theme/1",
  "name": "Esencial Vertical",
  "author": "Luzeira",
  "orientation": "portrait",
  "background": {"color": "#0c101c", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 16, "y": 10, "width": 180, "height": 64}, "style": {"size": 52, "bold": true, "color": "#ff8c00", "align": "left"}},
    {"type": "clock", "format": "date-short", "box": {"x": 196, "y": 30, "width": 108, "height": 22}, "style": {"size": 14, "color": "#8a93a6", "align": "right"}},
    {"type": "clock", "format": "date-long", "box": {"x": 16, "y": 76, "width": 288, "height": 24}, "style": {"size": 16, "color": "#e6e6e6", "align": "left"}},

    {"type": "text", "text": "CPU", "box": {"x": 28, "y": 122, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 28, "y": 146, "width": 116, "height": 44}, "style": {"size": 34, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#ff8c00", "track": "#2a2f3a", "box": {"x": 28, "y": 200, "width": 116, "height": 8}},

    {"type": "text", "text": "GPU", "box": {"x": 176, "y": 122, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 226, "y": 122, "width": 66, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 176, "y": 146, "width": 116, "height": 44}, "style": {"size": 34, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#ff8c00", "track": "#2a2f3a", "box": {"x": 176, "y": 200, "width": 116, "height": 8}},

    {"type": "text", "text": "RAM", "box": {"x": 28, "y": 242, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 78, "y": 242, "width": 66, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 28, "y": 266, "width": 116, "height": 44}, "style": {"size": 34, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#ff8c00", "track": "#2a2f3a", "box": {"x": 28, "y": 320, "width": 116, "height": 8}},

    {"type": "text", "text": "VRAM", "box": {"x": 176, "y": 242, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.memory_used", "decimals": 1, "box": {"x": 226, "y": 242, "width": 66, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.memory_usage", "box": {"x": 176, "y": 266, "width": 116, "height": 44}, "style": {"size": 34, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "gpu.memory_usage", "fill": "#ff8c00", "track": "#2a2f3a", "box": {"x": 176, "y": 320, "width": 116, "height": 8}},

    {"type": "text", "text": "DISCO C:", "text_i18n": { "en": "DISK C:", "de": "LW C:", "fr": "DISQUE C:", "it": "DISCO C:", "pt": "DISCO C:", "pl": "DYSK C:", "tr": "DİSK C:", "ru": "ДИСК C:" }, "box": {"x": 28, "y": 362, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "disk.usage.c", "interval": 10, "box": {"x": 28, "y": 386, "width": 116, "height": 44}, "style": {"size": 34, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "disk.usage.c", "interval": 10, "fill": "#ff8c00", "track": "#2a2f3a", "box": {"x": 28, "y": 440, "width": 116, "height": 8}},

    {"type": "text", "text": "RED", "text_i18n": { "en": "NET", "de": "NETZ", "fr": "RÉSEAU", "it": "RETE", "pt": "REDE", "pl": "SIEĆ", "tr": "AĞ", "ru": "СЕТЬ" }, "box": {"x": 176, "y": 362, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 176, "y": 388, "width": 116, "height": 30}, "style": {"size": 16, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 176, "y": 420, "width": 116, "height": 30}, "style": {"size": 16, "color": "#c8ccd6", "align": "left"}}
  ]
}
