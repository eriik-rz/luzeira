{
  "format": "luzeira-theme/1",
  "name": "Hielo",
  "author": "Luzeira",
  "orientation": "landscape",
  "background": {"color": "#05101f", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 14, "y": 6, "width": 252, "height": 80}, "style": {"size": 72, "bold": true, "color": "#eaf8ff", "align": "left"}},
    {"type": "clock", "format": "date-long", "box": {"x": 18, "y": 86, "width": 252, "height": 24}, "style": {"size": 16, "color": "#9fd8ff", "align": "left"}},

    {"type": "text", "text": "RED", "text_i18n": { "en": "NET", "de": "NETZ", "fr": "RÉSEAU", "it": "RETE", "pt": "REDE", "pl": "SIEĆ", "tr": "AĞ", "ru": "СЕТЬ", "zh": "网络", "ja": "ネット" }, "box": {"x": 290, "y": 22, "width": 100, "height": 20}, "style": {"size": 14, "bold": true, "color": "#7fe8e0", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 290, "y": 46, "width": 162, "height": 26}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 290, "y": 74, "width": 162, "height": 26}, "style": {"size": 18, "color": "#bfe6ff", "align": "left"}},

    {"type": "text", "text": "CPU", "box": {"x": 28, "y": 136, "width": 60, "height": 20}, "style": {"size": 15, "bold": true, "color": "#7fd4ff", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 28, "y": 164, "width": 124, "height": 52}, "style": {"size": 40, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#7fd4ff", "track": "#14324f", "box": {"x": 28, "y": 228, "width": 120, "height": 8}},
    {"type": "sensor", "sensor": "system.uptime", "decimals": 1, "prefix": "activo ", "prefix_i18n": { "en": "up ", "de": "seit ", "fr": "actif ", "it": "attivo ", "pt": "ativo ", "pl": "działa ", "tr": "açık ", "ru": "вкл. ", "zh": "运行 ", "ja": "稼働 " }, "box": {"x": 28, "y": 252, "width": 120, "height": 24}, "style": {"size": 15, "color": "#bfe6ff", "align": "left"}},

    {"type": "text", "text": "GPU", "box": {"x": 180, "y": 136, "width": 60, "height": 20}, "style": {"size": 15, "bold": true, "color": "#c4f1ff", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 232, "y": 136, "width": 68, "height": 20}, "style": {"size": 15, "color": "#bfe6ff", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 180, "y": 164, "width": 124, "height": 52}, "style": {"size": 40, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#c4f1ff", "track": "#1a3a55", "box": {"x": 180, "y": 228, "width": 120, "height": 8}},
    {"type": "sensor", "sensor": "gpu.power", "box": {"x": 180, "y": 252, "width": 120, "height": 24}, "style": {"size": 15, "color": "#bfe6ff", "align": "left"}},

    {"type": "text", "text": "RAM", "box": {"x": 332, "y": 136, "width": 60, "height": 20}, "style": {"size": 15, "bold": true, "color": "#a6b8ff", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 376, "y": 136, "width": 76, "height": 20}, "style": {"size": 15, "color": "#bfe6ff", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 332, "y": 164, "width": 124, "height": 52}, "style": {"size": 40, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#a6b8ff", "track": "#1c2c58", "box": {"x": 332, "y": 228, "width": 120, "height": 8}},
    {"type": "sensor", "sensor": "disk.usage.c", "interval": 10, "prefix": "Disco C: ", "prefix_i18n": { "en": "Disk C: ", "de": "Platte C: ", "fr": "Disque C: ", "it": "Disco C: ", "pt": "Disco C: ", "pl": "Dysk C: ", "tr": "Disk C: ", "ru": "Диск C: ", "zh": "C 盘 ", "ja": "C ドライブ " }, "box": {"x": 332, "y": 252, "width": 120, "height": 24}, "style": {"size": 15, "color": "#bfe6ff", "align": "left"}}
  ]
}
