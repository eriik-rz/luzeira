{
  "format": "luzeira-theme/1",
  "name": "Synthwave Vertical",
  "author": "Luzeira",
  "orientation": "portrait",
  "background": {"color": "#140328", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 16, "y": 8, "width": 288, "height": 72}, "style": {"size": 64, "bold": true, "color": "#ffe08a", "align": "center"}},
    {"type": "clock", "format": "date-long", "box": {"x": 16, "y": 80, "width": 288, "height": 26}, "style": {"size": 17, "color": "#ffb3e6", "align": "center"}},

    {"type": "text", "text": "CPU", "box": {"x": 28, "y": 250, "width": 52, "height": 22}, "style": {"size": 15, "bold": true, "color": "#ff9646", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 80, "y": 242, "width": 100, "height": 38}, "style": {"size": 30, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#ff9646", "track": "#3a1a2a", "box": {"x": 184, "y": 268, "width": 108, "height": 8}},

    {"type": "text", "text": "GPU", "box": {"x": 28, "y": 310, "width": 52, "height": 22}, "style": {"size": 15, "bold": true, "color": "#ff3cc8", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 80, "y": 302, "width": 100, "height": 38}, "style": {"size": 30, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 184, "y": 300, "width": 108, "height": 20}, "style": {"size": 14, "color": "#e8d6ff", "align": "right"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#ff3cc8", "track": "#3a0f3c", "box": {"x": 184, "y": 328, "width": 108, "height": 8}},

    {"type": "text", "text": "RAM", "box": {"x": 28, "y": 370, "width": 52, "height": 22}, "style": {"size": 15, "bold": true, "color": "#00dcff", "align": "left"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 80, "y": 362, "width": 100, "height": 38}, "style": {"size": 30, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 184, "y": 360, "width": 108, "height": 20}, "style": {"size": 14, "color": "#e8d6ff", "align": "right"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#00dcff", "track": "#0d2a44", "box": {"x": 184, "y": 388, "width": 108, "height": 8}},

    {"type": "text", "text": "RED", "text_i18n": { "en": "NET", "de": "NETZ", "fr": "RÉS.", "it": "RETE", "pt": "REDE", "pl": "SIEĆ", "tr": "AĞ", "ru": "СЕТЬ", "zh": "网络", "ja": "ネット" }, "box": {"x": 28, "y": 430, "width": 52, "height": 22}, "style": {"size": 15, "bold": true, "color": "#c88cff", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 72, "y": 418, "width": 220, "height": 22}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 72, "y": 440, "width": 220, "height": 22}, "style": {"size": 15, "color": "#e0b8ff", "align": "right"}}
  ]
}
