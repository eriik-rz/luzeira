    {"type": "sensor", "sensor": "gpu.memory_usage", "box": {"x": 338, "y": 210, "width": 112, "height": 44}, "style": {"size": 34, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "bar", "sensor": "gpu.memory_usage", "fill": "#2b2533", "track": "#e6cf7c", "box": {"x": 338, "y": 272, "width": 112, "height": 10}}

  ]
}
