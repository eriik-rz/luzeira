    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 338, "y": 62, "width": 112, "height": 44}, "style": {"size": 34, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#2b2533", "track": "#8fd0b5", "box": {"x": 338, "y": 124, "width": 112, "height": 10}},

    {"type": "text", "text": "RAM", "box": {"x": 190, "y": 178, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
