    {"type": "bar", "sensor": "cpu.usage", "fill": "#2b2533", "track": "#e8b48a", "box": {"x": 190, "y": 124, "width": 112, "height": 10}},

    {"type": "text", "text": "GPU", "box": {"x": 338, "y": 30, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
