{
  "format": "luzeira-theme/1",
  "name": "Tarjetas",
  "author": "Luzeira",
  "orientation": "landscape",
  "background": {"color": "#201d26", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "weekday", "box": {"x": 30, "y": 30, "width": 126, "height": 22}, "style": {"size": 15, "bold": true, "color": "#5c4f68", "align": "left"}},
    {"type": "clock", "format": "HH:MM", "box": {"x": 28, "y": 54, "width": 136, "height": 56}, "style": {"size": 42, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "clock", "format": "date-short", "box": {"x": 30, "y": 110, "width": 126, "height": 22}, "style": {"size": 15, "color": "#5c4f68", "align": "left"}},
    {"type": "text", "text": "ENCENDIDO", "text_i18n": { "en": "UPTIME", "de": "LAUFZEIT", "fr": "ALLUMÉ", "it": "ACCESO", "pt": "LIGADO", "pl": "CZAS PRACY", "tr": "ÇALIŞMA", "ru": "В РАБОТЕ" }, "box": {"x": 30, "y": 170, "width": 126, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
