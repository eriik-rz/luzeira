    {"type": "text", "text": "RED", "text_i18n": { "en": "NET", "de": "NETZ", "fr": "RÉSEAU", "it": "RETE", "pt": "REDE", "pl": "SIEĆ", "tr": "AĞ", "ru": "СЕТЬ" }, "box": {"x": 30, "y": 230, "width": 126, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 30, "y": 248, "width": 126, "height": 22}, "style": {"size": 15, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 30, "y": 270, "width": 126, "height": 22}, "style": {"size": 15, "color": "#5c4f68", "align": "left"}},

    {"type": "text", "text": "CPU", "box": {"x": 190, "y": 30, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
