{
  "format": "luzeira-theme/1",
  "name": "Retro Ámbar Vertical",
  "author": "Luzeira",
  "orientation": "portrait",
  "background": {"color": "#0e0802", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "date-long", "box": {"x": 16, "y": 14, "width": 288, "height": 24}, "style": {"size": 16, "color": "#d08a10", "align": "center"}},
    {"type": "clock", "format": "HH:MM", "box": {"x": 10, "y": 50, "width": 300, "height": 104}, "style": {"size": 96, "bold": true, "color": "#ffb000", "align": "center"}},

    {"type": "text", "text": "CPU", "box": {"x": 24, "y": 170, "width": 100, "height": 22}, "style": {"size": 16, "bold": true, "color": "#d08a10", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 24, "y": 192, "width": 150, "height": 52}, "style": {"size": 44, "bold": true, "color": "#ffb000", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#ffb000", "track": "#3a2304", "box": {"x": 180, "y": 214, "width": 116, "height": 12}},

    {"type": "text", "text": "GPU", "box": {"x": 24, "y": 250, "width": 100, "height": 22}, "style": {"size": 16, "bold": true, "color": "#d08a10", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 180, "y": 250, "width": 116, "height": 22}, "style": {"size": 15, "color": "#d08a10", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 24, "y": 272, "width": 150, "height": 52}, "style": {"size": 44, "bold": true, "color": "#ffb000", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#ffb000", "track": "#3a2304", "box": {"x": 180, "y": 294, "width": 116, "height": 12}},

    {"type": "text", "text": "RAM", "box": {"x": 24, "y": 330, "width": 100, "height": 22}, "style": {"size": 16, "bold": true, "color": "#d08a10", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 180, "y": 330, "width": 116, "height": 22}, "style": {"size": 15, "color": "#d08a10", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 24, "y": 352, "width": 150, "height": 52}, "style": {"size": 44, "bold": true, "color": "#ffb000", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#ffb000", "track": "#3a2304", "box": {"x": 180, "y": 374, "width": 116, "height": 12}},

    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 24, "y": 422, "width": 134, "height": 24}, "style": {"size": 17, "bold": true, "color": "#ffb000", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 162, "y": 422, "width": 134, "height": 24}, "style": {"size": 17, "color": "#ffb000", "align": "right"}},
    {"type": "sensor", "sensor": "disk.usage.c", "prefix": "disco C: ", "prefix_i18n": { "en": "disk C: ", "de": "laufwerk C: ", "fr": "disque C: ", "it": "disco C: ", "pt": "disco C: ", "pl": "dysk C: ", "tr": "disk C: ", "ru": "диск C: ", "zh": "C 盘 ", "ja": "C ドライブ " }, "interval": 10, "box": {"x": 24, "y": 448, "width": 272, "height": 22}, "style": {"size": 15, "color": "#d08a10", "align": "center"}},

    {"type": "image", "file": "barrido.png", "box": {"x": 0, "y": 0, "width": 320, "height": 480}}
  ]
}
