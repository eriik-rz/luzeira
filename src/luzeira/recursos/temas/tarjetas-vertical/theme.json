{
  "format": "luzeira-theme/1",
  "name": "Tarjetas Vertical",
  "author": "Luzeira",
  "orientation": "portrait",
  "background": {"color": "#201d26", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 32, "y": 26, "width": 170, "height": 64}, "style": {"size": 56, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "clock", "format": "weekday", "box": {"x": 200, "y": 34, "width": 90, "height": 22}, "style": {"size": 15, "bold": true, "color": "#5c4f68", "align": "right"}},
    {"type": "clock", "format": "date-short", "box": {"x": 200, "y": 60, "width": 90, "height": 22}, "style": {"size": 14, "color": "#5c4f68", "align": "right"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 32, "y": 100, "width": 130, "height": 24}, "style": {"size": 15, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 162, "y": 100, "width": 128, "height": 24}, "style": {"size": 15, "color": "#5c4f68", "align": "right"}},

    {"type": "text", "text": "CPU", "box": {"x": 30, "y": 158, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 30, "y": 186, "width": 112, "height": 44}, "style": {"size": 34, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#2b2533", "track": "#e8b48a", "box": {"x": 30, "y": 248, "width": 112, "height": 10}},

    {"type": "text", "text": "GPU", "box": {"x": 178, "y": 158, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 226, "y": 158, "width": 64, "height": 18}, "style": {"size": 14, "color": "#5c4f68", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 178, "y": 186, "width": 112, "height": 44}, "style": {"size": 34, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#2b2533", "track": "#8fd0b5", "box": {"x": 178, "y": 248, "width": 112, "height": 10}},

    {"type": "text", "text": "RAM", "box": {"x": 30, "y": 298, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 78, "y": 298, "width": 64, "height": 18}, "style": {"size": 14, "color": "#5c4f68", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 30, "y": 326, "width": 112, "height": 44}, "style": {"size": 34, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#2b2533", "track": "#a9aedb", "box": {"x": 30, "y": 388, "width": 112, "height": 10}},

    {"type": "text", "text": "VRAM", "box": {"x": 178, "y": 298, "width": 70, "height": 18}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.memory_used", "decimals": 1, "box": {"x": 226, "y": 298, "width": 64, "height": 18}, "style": {"size": 14, "color": "#5c4f68", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.memory_usage", "box": {"x": 178, "y": 326, "width": 112, "height": 44}, "style": {"size": 34, "bold": true, "color": "#2b2533", "align": "left"}},
    {"type": "bar", "sensor": "gpu.memory_usage", "fill": "#2b2533", "track": "#e6cf7c", "box": {"x": 178, "y": 388, "width": 112, "height": 10}},

    {"type": "text", "text": "ENCENDIDO", "box": {"x": 30, "y": 424, "width": 120, "height": 40}, "style": {"size": 14, "bold": true, "color": "#5c4f68", "align": "left"}},
    {"type": "sensor", "sensor": "system.uptime", "decimals": 1, "interval": 60, "box": {"x": 150, "y": 424, "width": 140, "height": 40}, "style": {"size": 18, "bold": true, "color": "#2b2533", "align": "right"}}
  ]
}
