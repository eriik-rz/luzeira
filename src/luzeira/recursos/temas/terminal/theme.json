{
  "format": "luzeira-theme/1",
  "name": "Terminal",
  "author": "Luzeira",
  "orientation": "landscape",
  "background": {"color": "#020904", "image": "fondo.png"},
  "widgets": [
    {"type": "text", "text": "luzeira — monitor", "box": {"x": 12, "y": 4, "width": 200, "height": 22}, "style": {"size": 14, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "clock", "format": "date-short", "box": {"x": 212, "y": 4, "width": 140, "height": 22}, "style": {"size": 14, "color": "#1fa84a", "align": "right"}},
    {"type": "clock", "format": "HH:MM:SS", "box": {"x": 360, "y": 4, "width": 108, "height": 22}, "style": {"size": 14, "bold": true, "color": "#3dff6e", "align": "right"}},

    {"type": "text", "text": "> cpu", "box": {"x": 16, "y": 42, "width": 92, "height": 24}, "style": {"size": 16, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 108, "y": 42, "width": 100, "height": 24}, "style": {"size": 16, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#3dff6e", "track": "#0b2a14", "box": {"x": 212, "y": 48, "width": 176, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 212, "y": 48, "width": 176, "height": 12}},

    {"type": "text", "text": "> gpu", "box": {"x": 16, "y": 74, "width": 92, "height": 24}, "style": {"size": 16, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 108, "y": 74, "width": 100, "height": 24}, "style": {"size": 16, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#3dff6e", "track": "#0b2a14", "box": {"x": 212, "y": 80, "width": 176, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 212, "y": 80, "width": 176, "height": 12}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 392, "y": 74, "width": 72, "height": 24}, "style": {"size": 15, "color": "#1fa84a", "align": "right"}},

    {"type": "text", "text": "> vram", "box": {"x": 16, "y": 106, "width": 92, "height": 24}, "style": {"size": 16, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.memory_used", "decimals": 1, "box": {"x": 108, "y": 106, "width": 100, "height": 24}, "style": {"size": 16, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "bar", "sensor": "gpu.memory_usage", "fill": "#3dff6e", "track": "#0b2a14", "box": {"x": 212, "y": 112, "width": 176, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 212, "y": 112, "width": 176, "height": 12}},
    {"type": "sensor", "sensor": "gpu.power", "box": {"x": 392, "y": 106, "width": 72, "height": 24}, "style": {"size": 15, "color": "#1fa84a", "align": "right"}},

    {"type": "text", "text": "> ram", "box": {"x": 16, "y": 138, "width": 92, "height": 24}, "style": {"size": 16, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 108, "y": 138, "width": 100, "height": 24}, "style": {"size": 16, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#3dff6e", "track": "#0b2a14", "box": {"x": 212, "y": 144, "width": 176, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 212, "y": 144, "width": 176, "height": 12}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 392, "y": 138, "width": 72, "height": 24}, "style": {"size": 15, "color": "#1fa84a", "align": "right"}},

    {"type": "text", "text": "> disco c:", "box": {"x": 16, "y": 170, "width": 92, "height": 24}, "style": {"size": 16, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "disk.usage.c", "interval": 10, "box": {"x": 108, "y": 170, "width": 100, "height": 24}, "style": {"size": 16, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "bar", "sensor": "disk.usage.c", "interval": 10, "fill": "#3dff6e", "track": "#0b2a14", "box": {"x": 212, "y": 176, "width": 176, "height": 12}},
    {"type": "image", "file": "segmentos.png", "box": {"x": 212, "y": 176, "width": 176, "height": 12}},

    {"type": "text", "text": "> red", "box": {"x": 16, "y": 202, "width": 92, "height": 24}, "style": {"size": 16, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 108, "y": 202, "width": 170, "height": 24}, "style": {"size": 16, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 290, "y": 202, "width": 174, "height": 24}, "style": {"size": 16, "color": "#3dff6e", "align": "left"}},

    {"type": "text", "text": "> e/s", "box": {"x": 16, "y": 234, "width": 92, "height": 24}, "style": {"size": 16, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "disk.read", "decimals": 1, "prefix": "lee ", "box": {"x": 108, "y": 234, "width": 170, "height": 24}, "style": {"size": 16, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "sensor", "sensor": "disk.write", "decimals": 1, "prefix": "esc ", "box": {"x": 290, "y": 234, "width": 174, "height": 24}, "style": {"size": 16, "color": "#3dff6e", "align": "left"}},

    {"type": "text", "text": "$", "box": {"x": 16, "y": 288, "width": 16, "height": 24}, "style": {"size": 15, "bold": true, "color": "#3dff6e", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.name", "max_chars": 37, "interval": 3600, "box": {"x": 34, "y": 288, "width": 300, "height": 24}, "style": {"size": 14, "color": "#1fa84a", "align": "left"}},
    {"type": "sensor", "sensor": "system.uptime", "decimals": 1, "prefix": "activo ", "interval": 60, "box": {"x": 340, "y": 288, "width": 124, "height": 24}, "style": {"size": 14, "color": "#1fa84a", "align": "right"}}
  ]
}
