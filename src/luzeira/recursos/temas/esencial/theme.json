{
  "format": "luzeira-theme/1",
  "name": "Esencial",
  "author": "Luzeira",
  "orientation": "landscape",
  "background": { "color": "#0c101c" },
  "widgets": [
    { "type": "clock", "format": "HH:MM", "box": { "x": 16, "y": 8, "width": 200, "height": 64 },
      "style": { "size": 52, "bold": true, "color": "#ff8c00", "align": "left" } },
    { "type": "clock", "format": "date-long", "box": { "x": 180, "y": 14, "width": 284, "height": 28 },
      "style": { "size": 18, "color": "#e6e6e6", "align": "right" } },
    { "type": "clock", "format": "date-short", "box": { "x": 216, "y": 42, "width": 248, "height": 24 },
      "style": { "size": 15, "color": "#8a93a6", "align": "right" } },

    { "type": "text", "text": "CPU", "box": { "x": 16, "y": 86, "width": 216, "height": 24 },
      "style": { "size": 16, "bold": true, "color": "#8a93a6", "align": "left" } },
    { "type": "sensor", "sensor": "cpu.usage", "box": { "x": 16, "y": 110, "width": 216, "height": 52 },
      "style": { "size": 42, "bold": true, "align": "left" } },
    { "type": "bar", "sensor": "cpu.usage", "box": { "x": 16, "y": 168, "width": 216, "height": 10 } },

    { "type": "text", "text": "GPU", "box": { "x": 248, "y": 86, "width": 120, "height": 24 },
      "style": { "size": 16, "bold": true, "color": "#8a93a6", "align": "left" } },
    { "type": "sensor", "sensor": "gpu.temperature", "box": { "x": 368, "y": 86, "width": 96, "height": 24 },
      "style": { "size": 16, "color": "#8a93a6", "align": "right" } },
    { "type": "sensor", "sensor": "gpu.usage", "box": { "x": 248, "y": 110, "width": 216, "height": 52 },
      "style": { "size": 42, "bold": true, "align": "left" } },
    { "type": "bar", "sensor": "gpu.usage",
      "box": { "x": 248, "y": 168, "width": 216, "height": 10 } },

    { "type": "text", "text": "RAM", "box": { "x": 16, "y": 200, "width": 100, "height": 24 },
      "style": { "size": 16, "bold": true, "color": "#8a93a6", "align": "left" } },
    { "type": "sensor", "sensor": "memory.used", "decimals": 1, "box": { "x": 116, "y": 200, "width": 116, "height": 24 },
      "style": { "size": 16, "color": "#8a93a6", "align": "right" } },
    { "type": "sensor", "sensor": "memory.usage", "box": { "x": 16, "y": 224, "width": 216, "height": 52 },
      "style": { "size": 42, "bold": true, "align": "left" } },
    { "type": "bar", "sensor": "memory.usage", "box": { "x": 16, "y": 282, "width": 216, "height": 10 } },

    { "type": "text", "text": "RED", "text_i18n": { "en": "NET", "de": "NETZ", "fr": "RÉSEAU", "it": "RETE", "pt": "REDE", "pl": "SIEĆ", "tr": "AĞ", "ru": "СЕТЬ" }, "box": { "x": 248, "y": 200, "width": 216, "height": 24 },
      "style": { "size": 16, "bold": true, "color": "#8a93a6", "align": "left" } },
    { "type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ",
      "box": { "x": 248, "y": 228, "width": 216, "height": 30 },
      "style": { "size": 24, "bold": true, "align": "left" } },
    { "type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ",
      "box": { "x": 248, "y": 260, "width": 216, "height": 30 },
      "style": { "size": 24, "color": "#c8ccd6", "align": "left" } }
  ]
}
