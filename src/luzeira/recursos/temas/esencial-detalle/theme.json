{
  "format": "luzeira-theme/1",
  "name": "Esencial Detalle",
  "author": "Luzeira",
  "orientation": "landscape",
  "background": {"color": "#0c101c", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 16, "y": 6, "width": 120, "height": 40}, "style": {"size": 30, "bold": true, "color": "#ff8c00", "align": "left"}},
    {"type": "clock", "format": "date-long", "box": {"x": 136, "y": 6, "width": 328, "height": 40}, "style": {"size": 15, "color": "#e6e6e6", "align": "right"}},

    {"type": "text", "text": "SISTEMA", "box": {"x": 16, "y": 56, "width": 120, "height": 18}, "style": {"size": 14, "bold": true, "color": "#ff8c00", "align": "left"}},
    {"type": "text", "text": "GPU", "box": {"x": 252, "y": 56, "width": 120, "height": 18}, "style": {"size": 14, "bold": true, "color": "#ff8c00", "align": "left"}},

    {"type": "text", "text": "CPU", "box": {"x": 16, "y": 78, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 112, "y": 78, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#ff8c00", "track": "#222a3d", "box": {"x": 16, "y": 99, "width": 212, "height": 4}},
    {"type": "text", "text": "RAM", "box": {"x": 16, "y": 109, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 112, "y": 109, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#ff8c00", "track": "#222a3d", "box": {"x": 16, "y": 130, "width": 212, "height": 4}},
    {"type": "text", "text": "Disco C:", "box": {"x": 16, "y": 140, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "disk.usage.c", "interval": 10, "box": {"x": 112, "y": 140, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "disk.usage.c", "interval": 10, "fill": "#ff8c00", "track": "#222a3d", "box": {"x": 16, "y": 161, "width": 212, "height": 4}},
    {"type": "text", "text": "Lectura", "box": {"x": 16, "y": 171, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "disk.read", "decimals": 1, "box": {"x": 112, "y": 171, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "text", "text": "Escritura", "box": {"x": 16, "y": 202, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "disk.write", "decimals": 1, "box": {"x": 112, "y": 202, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "text", "text": "Encendido", "box": {"x": 16, "y": 233, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "system.uptime", "decimals": 1, "interval": 60, "box": {"x": 112, "y": 233, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},

    {"type": "text", "text": "Uso", "box": {"x": 252, "y": 78, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 348, "y": 78, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#ffb35c", "track": "#222a3d", "box": {"x": 252, "y": 99, "width": 212, "height": 4}},
    {"type": "text", "text": "VRAM", "box": {"x": 252, "y": 109, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.memory_used", "decimals": 1, "box": {"x": 348, "y": 109, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "gpu.memory_usage", "fill": "#ffb35c", "track": "#222a3d", "box": {"x": 252, "y": 130, "width": 212, "height": 4}},
    {"type": "text", "text": "Temperatura", "box": {"x": 252, "y": 140, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 348, "y": 140, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "bar", "sensor": "gpu.temperature", "min": 20, "max": 100, "fill": "#ffb35c", "track": "#222a3d", "box": {"x": 252, "y": 161, "width": 212, "height": 4}},
    {"type": "text", "text": "Ventilador", "box": {"x": 252, "y": 171, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.fan", "interval": 2, "box": {"x": 348, "y": 171, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "text", "text": "Potencia", "box": {"x": 252, "y": 202, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.power", "box": {"x": 348, "y": 202, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},
    {"type": "text", "text": "Reloj", "box": {"x": 252, "y": 233, "width": 100, "height": 18}, "style": {"size": 14, "color": "#8a93a6", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.clock", "interval": 2, "box": {"x": 348, "y": 233, "width": 116, "height": 18}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "right"}},

    {"type": "text", "text": "RED", "box": {"x": 16, "y": 276, "width": 50, "height": 20}, "style": {"size": 14, "bold": true, "color": "#ff8c00", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 66, "y": 276, "width": 170, "height": 20}, "style": {"size": 15, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 252, "y": 276, "width": 212, "height": 20}, "style": {"size": 15, "color": "#c8ccd6", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.name", "max_chars": 27, "interval": 3600, "box": {"x": 16, "y": 298, "width": 220, "height": 18}, "style": {"size": 14, "color": "#6b7487", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.name", "max_chars": 26, "interval": 3600, "box": {"x": 252, "y": 298, "width": 212, "height": 18}, "style": {"size": 14, "color": "#6b7487", "align": "right"}}
  ]
}
