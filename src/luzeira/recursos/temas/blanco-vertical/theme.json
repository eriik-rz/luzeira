    {"type": "bar", "sensor": "memory.usage", "fill": "#181818", "track": "#dcd8cf", "box": {"x": 24, "y": 412, "width": 272, "height": 6}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 24, "y": 442, "width": 136, "height": 26}, "style": {"size": 16, "color": "#181818", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 160, "y": 442, "width": 136, "height": 26}, "style": {"size": 16, "color": "#5f5b54", "align": "right"}}
  ]
