    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 24, "y": 296, "width": 110, "height": 20}, "style": {"size": 14, "color": "#5f5b54", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.usage", "show_unit": false, "suffix": "%", "box": {"x": 130, "y": 270, "width": 166, "height": 58}, "style": {"size": 50, "color": "#181818", "align": "right"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#181818", "track": "#dcd8cf", "box": {"x": 24, "y": 332, "width": 272, "height": 6}},
    {"type": "text", "text": "RAM", "box": {"x": 24, "y": 354, "width": 100, "height": 20}, "style": {"size": 14, "bold": true, "color": "#5f5b54", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 24, "y": 376, "width": 110, "height": 20}, "style": {"size": 14, "color": "#5f5b54", "align": "left"}},
