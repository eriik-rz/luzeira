{
  "format": "luzeira-theme/1",
  "name": "Hielo Vertical",
  "author": "Luzeira",
  "orientation": "portrait",
  "background": {"color": "#05101f", "image": "fondo.png"},
  "widgets": [
    {"type": "clock", "format": "HH:MM", "box": {"x": 16, "y": 16, "width": 288, "height": 84}, "style": {"size": 76, "bold": true, "color": "#eaf8ff", "align": "center"}},
    {"type": "clock", "format": "date-long", "box": {"x": 16, "y": 98, "width": 288, "height": 24}, "style": {"size": 16, "color": "#9fd8ff", "align": "center"}},

    {"type": "text", "text": "CPU", "box": {"x": 28, "y": 146, "width": 100, "height": 18}, "style": {"size": 14, "bold": true, "color": "#7fd4ff", "align": "left"}},
    {"type": "sensor", "sensor": "cpu.usage", "box": {"x": 28, "y": 164, "width": 118, "height": 40}, "style": {"size": 32, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "cpu.usage", "fill": "#7fd4ff", "track": "#14324f", "box": {"x": 150, "y": 182, "width": 142, "height": 8}},

    {"type": "text", "text": "GPU", "box": {"x": 28, "y": 230, "width": 100, "height": 18}, "style": {"size": 14, "bold": true, "color": "#c4f1ff", "align": "left"}},
    {"type": "sensor", "sensor": "gpu.temperature", "box": {"x": 150, "y": 230, "width": 142, "height": 18}, "style": {"size": 14, "color": "#bfe6ff", "align": "right"}},
    {"type": "sensor", "sensor": "gpu.usage", "box": {"x": 28, "y": 248, "width": 118, "height": 40}, "style": {"size": 32, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "gpu.usage", "fill": "#c4f1ff", "track": "#1a3a55", "box": {"x": 150, "y": 266, "width": 142, "height": 8}},

    {"type": "text", "text": "RAM", "box": {"x": 28, "y": 314, "width": 100, "height": 18}, "style": {"size": 14, "bold": true, "color": "#a6b8ff", "align": "left"}},
    {"type": "sensor", "sensor": "memory.used", "decimals": 1, "box": {"x": 150, "y": 314, "width": 142, "height": 18}, "style": {"size": 14, "color": "#bfe6ff", "align": "right"}},
    {"type": "sensor", "sensor": "memory.usage", "box": {"x": 28, "y": 332, "width": 118, "height": 40}, "style": {"size": 32, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "bar", "sensor": "memory.usage", "fill": "#a6b8ff", "track": "#1c2c58", "box": {"x": 150, "y": 350, "width": 142, "height": 8}},

    {"type": "text", "text": "RED", "text_i18n": { "en": "NET" }, "box": {"x": 28, "y": 398, "width": 100, "height": 18}, "style": {"size": 14, "bold": true, "color": "#7fe8e0", "align": "left"}},
    {"type": "sensor", "sensor": "network.download", "decimals": 1, "prefix": "↓ ", "box": {"x": 28, "y": 422, "width": 134, "height": 30}, "style": {"size": 18, "bold": true, "color": "#ffffff", "align": "left"}},
    {"type": "sensor", "sensor": "network.upload", "decimals": 1, "prefix": "↑ ", "box": {"x": 164, "y": 422, "width": 128, "height": 30}, "style": {"size": 18, "color": "#bfe6ff", "align": "right"}}
  ]
}
