<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto MSIX de Luzeira (versión de Microsoft Store, C-52). Lo rellena
  scripts/empaquetar_msix.py: los marcadores con dólar son la identidad que da Partner Center y la versión.

  - FullTrustApplication + runFullTrust: es una app de escritorio normal (puerto COM,
    bandeja, editor). Probado en el prototipo del 2026-11-20.
  - El icono abre también el editor, como los accesos del instalador.
  - Ojo: un comentario XML no puede llevar dos guiones seguidos (ni los de las opciones).
  - Tarea de inicio: el inicio con Windows de la Store (la clave Run queda aislada dentro
    del paquete). Activada por defecto, como en el instalador; el usuario la quita en
    Configuración → Aplicaciones → Inicio. Arranca solo la bandeja, sin abrir el editor.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop rescap">
  <Identity Name="${name}" Publisher="${publisher}" Version="${version}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Luzeira</DisplayName>
    <PublisherDisplayName>${publisher_name}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="es-es" />
  </Resources>
  <Applications>
    <Application Id="Luzeira" Executable="python\pythonw.exe" EntryPoint="Windows.FullTrustApplication"
                 uap10:Parameters="-m luzeira --abrir-editor">
      <uap:VisualElements DisplayName="Luzeira" Description="Tu PC en la pantallita USB"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150.png" Square44x44Logo="Assets\Square44.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="python\pythonw.exe"
                           EntryPoint="Windows.FullTrustApplication" uap10:Parameters="-m luzeira">
          <desktop:StartupTask TaskId="LuzeiraInicio" Enabled="true" DisplayName="Luzeira" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
