    {"type": "bar", "sensor": "gpu.load", "box": {"x": 0, "y": 100, "width": 480, "height": 20}},
    {"type": "image", "file": "img/logo.jpg", "box": {"x": 0, "y": 140, "width": 64, "height": 64}},
    {"type": "image", "file": "img/anim.gif", "box": {"x": 80, "y": 140, "width": 64, "height": 64}}
