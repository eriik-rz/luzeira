<Project>
  <!--
    Lo común a todos los proyectos del módulo «Luzeira Sensores» (ADR-007 y ADR-008).

    - Build determinista (mismos fuentes → mismos binarios) y con rutas normalizadas.
    - Restauración con packages.lock.json en modo bloqueado: si alguien cambia una
      versión o un paquete cambia de contenido, la restauración falla en vez de bajar
      otra cosa. Para actualizar a propósito: «dotnet restore -p:RestoreLockedMode=false»
      con la opción force-evaluate (no se escribe aquí: un comentario XML no admite
      dos guiones seguidos).
    - Versiones de los paquetes en Directory.Packages.props (una sola lista, exactas).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Version>0.1.0</Version>
    <Authors>Luzeira contributors</Authors>
    <Company>Luzeira contributors</Company>
    <Product>Luzeira Sensores</Product>
    <Copyright>Luzeira contributors. GPL-3.0-or-later.</Copyright>
    <!-- Sin el hash del commit pegado a la versión: la versión va en el fichero de
         sensores (16 bytes como mucho) y tiene que ser la misma en cualquier equipo. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>

    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- Sin datos de cultura: el servicio no muestra fechas ni números a nadie. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
