<?xml version="1.0" encoding="utf-8"?>
<!--
  Una sola fuente de paquetes: nuget.org (ADR-007, punto 8). <clear/> quita cualquier
  otra fuente que haya en la configuración del usuario o de la máquina, y el mapeo de
  fuentes («package source mapping») obliga a que cada paquete venga de ella.
  Las versiones y los hashes los fija packages.lock.json (restauración en modo bloqueado).

  Firmas (signatureValidationMode=require): NuGet solo acepta un paquete si lo firma
  uno de estos:
  - nuget.org como repositorio (sus tres certificados, los que publica su índice de
    servicio) Y el paquete es de uno de estos propietarios: lhm (LibreHardwareMonitor),
    Blacktempel (DiskInfoToolkit, RAMSPDToolkit-NDD, BlackSharp.Core), JamesBellinger
    (HidSharp), Microsoft/dotnetframework/Xamarin (.NET, Mono.Posix), xunit y vstest
    (solo tests). Así, un paquete con nuestro nombre subido por otra cuenta no pasa.
  - Microsoft como autor.
  Generado el 2026-11-25 con «dotnet nuget trust source nuget.org» y «dotnet nuget trust
  author»; los propietarios, leídos de la firma de cada paquete con «dotnet nuget verify».
  Un paquete nuevo de otro propietario exige añadirlo aquí a propósito.
  Ojo: NuGet comprueba la firma al extraer el paquete a la caché; uno que ya estuviera
  en la caché local no se vuelve a comprobar (en CI la caché empieza vacía).
-->
<configuration>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <owners>lhm;Microsoft;dotnetframework;JamesBellinger;Blacktempel;Xamarin;xunit;vstest</owners>
    </repository>
    <author name="Microsoft">
      <certificate fingerprint="566A31882BE208BE4422F7CFD66ED09F5D4524A5994F50CCC8B05EC0528C1353" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
  </trustedSigners>
</configuration>
